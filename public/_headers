/*
  ! Access-Control-Allow-Origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; frame-src 'none'; object-src 'none'; worker-src 'none'; img-src 'self' data: blob:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' blob:
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: image/svg+xml

/favicon.ico
  Cache-Control: public, max-age=604800, must-revalidate

/icon.svg
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: image/svg+xml

/icon-maskable.svg
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: image/svg+xml

/apple-touch-icon.png
  Cache-Control: public, max-age=604800, must-revalidate

/icon-192.png
  Cache-Control: public, max-age=604800, must-revalidate

/icon-512.png
  Cache-Control: public, max-age=604800, must-revalidate

/icon-maskable-512.png
  Cache-Control: public, max-age=604800, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: application/manifest+json

/og.png
  Cache-Control: public, max-age=604800, must-revalidate

/robots.txt
  Cache-Control: public, max-age=604800, must-revalidate

/llms.txt
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: text/plain; charset=utf-8

/AGENTS.md
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: text/markdown; charset=utf-8

/index.md
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: text/markdown; charset=utf-8

/sitemap.md
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: text/markdown; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=604800, must-revalidate

/LICENSE
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: text/plain; charset=utf-8

/.well-known/security.txt
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: text/plain; charset=utf-8

/css/styles.*.css
  Cache-Control: public, max-age=31536000, immutable

/scripts/app.*.js
  Cache-Control: public, max-age=31536000, immutable

/scripts/scene.*.js
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=604800, must-revalidate

# The build publishes fonts only as name.HASH.woff2.
/fonts/:name.:hash.woff2
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800, must-revalidate

# Build fingerprints (name.HASH.ext) replace the /images/* rule above, so they
# must follow it. A placeholder stops only at "/": one-dot stable names never match.
/images/:name.:hash.webp
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/images/architecture/:name.:hash.glb
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The film slate's maps are fingerprinted like the models; the build publishes
# no plain-name copy of a fingerprinted image, model or map.
/images/materials/slate-:map.:hash.webp
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
